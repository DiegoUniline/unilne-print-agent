{
  "name": "mamux-print-agent",
  "productName": "Mamux Print Agent",
  "version": "2.1.0",
  "description": "Agente local de impresión directa de tickets para Mamux (USB, RAW, red y driver)",
  "author": "Uniline",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/**/*.test.js\"",
    "dist": "electron-builder --win --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg --arm64 --publish never"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "usb": "^2.18.0"
  },
  "build": {
    "appId": "mx.mamux.printagent",
    "productName": "Mamux Print Agent",
    "artifactName": "Mamux-Print-Agent-Setup.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mamux Print Agent",
      "runAfterFinish": true,
      "include": "build/installer.nsh"
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["arm64"] }],
      "category": "public.app-category.business",
      "identity": null
    },
    "dmg": {
      "artifactName": "Mamux-Print-Agent.${ext}"
    },
    "publish": null,
    "asarUnpack": ["**/*.node"],
    "npmRebuild": false
  }
}
